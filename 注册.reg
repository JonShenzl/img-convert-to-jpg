; ImgConvertToJpg：注册右键菜单 + 开机自启
; 安装路径固定为 C:\Tools\ImgConvertToJpg\ImgConvertToJpg.exe，升级版本无需重新导入
; 双击导入即可，无需管理员；菜单入口：右键 → 显示更多选项 → 转换为 JPG

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.apng\shell\ImgConvertToJpg.Convert]
@="转换为 JPG"
"MUIVerb"="转换为 JPG"
"MultiSelectModel"="Player"
"Icon"="\"C:\\Tools\\ImgConvertToJpg\\ImgConvertToJpg.exe\",0"

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.apng\shell\ImgConvertToJpg.Convert\command]
@="\"C:\\Tools\\ImgConvertToJpg\\ImgConvertToJpg.exe\" --convert \"%1\""

